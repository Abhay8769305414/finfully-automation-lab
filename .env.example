# -----------------------------------------------------------------------------
# Finfully Automation Lab -- Environment Configuration Template
# Copy to .env for local runtime usage. DO NOT commit actual .env credentials.
# -----------------------------------------------------------------------------

# Application Mode: 'development' | 'testing' | 'production'
APP_ENV=development

# Security Token for REST API Endpoints (Required in production)
API_AUTH_TOKEN=

# Database Persistence Engine: 'postgres' | 'sqlite'
DATABASE_BACKEND=postgres

# PostgreSQL Connection Credentials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finfully
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MIN_CONN=1
POSTGRES_MAX_CONN=10

# Celery & Redis Task Queue Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Mock Microservices Base URLs (Docker Service DNS or localhost)
CUSTOMER_API_URL=http://customer-api:8001
PRODUCT_API_URL=http://product-api:8002
TAX_API_URL=http://tax-api:8003
ACCOUNTING_API_URL=http://accounting-api:8004
NOTIFICATION_API_URL=http://notification-api:8005

# LLM / AI Configuration
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# n8n Security Settings
N8N_ENCRYPTION_KEY=finfully_n8n_secret_key_change_in_prod
